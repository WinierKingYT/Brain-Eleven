.claude/context-router-cache.json
.claude/authority-cache.json

# Archive (historical reference only)
.archived/

# Cache (Phase 9A disk cache - L3, regenerated at runtime)
cache/
logs/

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.phase-evidence/
.claude/context-compiler-v2-cache.json
.claude/session-run-result.json
.claude/session-runs/

# Security scan artifacts (regenerated by security.yml)
bandit-report.json

# Phase 15 evaluation privacy boundary: public synthetic corpus is versioned;
# a user's real local prompts, fixtures, and reports never are.
evals/private/
evals/reports/local/
task-state-*-report.json
router-*-report.json
authority-*-report.json
*-local-junit.xml

# Local Codex verification workspace; never source-controlled.
.test-tmp/
.test-deps/
.test-phase19-*/
