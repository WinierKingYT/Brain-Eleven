*.sh text eol=lf

# Extensionless hook scripts are run by bash, so they must stay LF on every
# checkout; core.autocrlf=true would otherwise turn them into CRLF and break
# them ("$'\r': command not found").
templates/claude/hooks/* text eol=lf
templates/claude/legacy/* text eol=lf

# Generated evaluation evidence is byte-pinned and must be identical on Windows.
evals/ig01f/public/ig01f-recency-v1/* text eol=lf
evals/ig01f/*.json text eol=lf
