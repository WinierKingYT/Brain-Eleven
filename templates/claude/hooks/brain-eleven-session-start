#!/usr/bin/env bash
# Brain-Eleven global SessionStart integration.
# Retrieval is project-aware: current project + global memories only.

set -u

BRAIN_ELEVEN_VAULT="${BRAIN_ELEVEN_VAULT:-{{VAULT_PATH}}}"
COMPILER="$BRAIN_ELEVEN_VAULT/scripts/context-compiler.py"

if [ ! -f "$COMPILER" ]; then
    exit 0
fi

# Prefer a persisted projection only when it exactly matches the canonical
# memory revision and current project scope. On a missing, corrupt, stale, or
# scope-mismatched projection, compile a fresh read-only context instead.
if ! PYTHONIOENCODING=utf-8 python "$COMPILER" \
    --vault "$BRAIN_ELEVEN_VAULT" \
    --project-root "$PWD" \
    --retrieval-scope default \
    --load-bootstrap 2>/dev/null; then
    PYTHONIOENCODING=utf-8 python "$COMPILER" \
        --vault "$BRAIN_ELEVEN_VAULT" \
        --project-root "$PWD" \
        --retrieval-scope default \
        --stdout 2>/dev/null || true
fi

exit 0
