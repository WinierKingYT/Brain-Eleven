# Brain-Eleven v3 - Environment configuration
# Copy this file to .env and fill in real values. Never commit .env itself.

# Required for real semantic embeddings (text-embedding-3-small).
# Without this, embedding-generator.py silently falls back to a
# deterministic hash-based vector - searches still "work" but have no
# actual semantic understanding.
OPENAI_API_KEY=

# Optional - only needed if running Redis (L2 cache) outside Docker.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional - only needed for the docker-compose Postgres service.
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brain_eleven
