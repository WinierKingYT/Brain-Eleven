# Brain-Eleven v3 - Environment configuration
# Copy this file to .env and fill in real values. Never commit .env itself.

# Required for real semantic embeddings (text-embedding-3-small).
# Without this, embedding-generator.py silently falls back to a
# deterministic hash-based vector - searches still "work" but have no
# actual semantic understanding.
OPENAI_API_KEY=

# Optional - only needed if running Redis (L2 cache) outside Docker.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional - only needed for the docker-compose Postgres service.
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brain_eleven

# Required if the API will be reachable from anywhere other than this
# machine. Unset = every endpoint except /health is unauthenticated
# (memory CRUD, cache clear, graph rebuild, chat - all wide open).
# When set, callers must send it back as the X-API-Key header.
BRAIN_ELEVEN_API_KEY=

# Optional - comma-separated allowed CORS origins. Defaults to a handful
# of localhost dev origins if unset; set explicitly for a real deployment.
CORS_ALLOWED_ORIGINS=

# Optional - interface to bind. Defaults to 127.0.0.1 (loopback only).
# docker-compose.yml overrides this to 0.0.0.0 itself since the container
# boundary is what actually isolates it there.
BRAIN_ELEVEN_HOST=127.0.0.1
